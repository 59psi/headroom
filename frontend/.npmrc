# The Node range every locked package accepts (`package.json` `engines`:
# 22.22.2+ / 24.15+ / 26+, jsdom 30's — the narrowest in the lockfile) is a
# hard error, not a warning: `npm ci` on a Node outside it fails here rather
# than building an image that misbehaves at runtime. setup.sh checks the same
# range for the friendlier local message, and `tests/test_toolchain_pins.py`
# derives it from `package-lock.json` and holds both to it.
engine-strict=true

# No `min-release-age` here, on purpose. The seven-day cooldown the Python
# side gets from `exclude-newer` is enforced for npm where versions actually
# enter the tree: Dependabot's `cooldown: default-days: 7` proposes nothing
# younger, and `npm ci` installs exactly what the lockfile pins (it honors the
# lock rather than re-resolving, so the setting would guard nothing there).
# Set in this file it would also apply to the pinned `npm install -g npm@X`
# that CI runs from this directory — refusing the very npm the build pins
# whenever that release is under a week old — and to every `npx` one-off, and
# `min-release-age-exclude=npm` does not reliably exempt the self-upgrade
# across the npm 11 (local) / npm 12 (image, CI) split. Checked 2026-09-28.
