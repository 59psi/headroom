.git
.github
.venv
.pytest_cache
__pycache__
*.pyc
node_modules
frontend/dist
frontend/node_modules
uploads
*.db
# WAL sidecars carry live data on a box that ran bare-metal before Docker.
*.db-wal
*.db-shm
*.sqlite
# Rolling backups: whole DB, API keys, session ids, the bearer token —
# a credential bundle one `git add -A` (or one build context) from leaking.
backups/
# Private keys never belong in an image or a build context.
*.pem
*.key
# The 3D-print bundle is a release asset, not build input.
hardware
.env
.env.*
.DS_Store
.claude
Headroom.zip
tests/.coverage
.python-version

# Nothing in the build COPYs these, and every byte of context is uploaded to
# the daemon before the first layer runs — which on a Pi is time spent before
# anything has started.
tests
docs
analysis
.ruff_cache
htmlcov
.coverage
CHANGELOG.md
CLAUDE.md
