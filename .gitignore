# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
*.egg-info/
build/
dist/
.pytest_cache/
.coverage
htmlcov/

# Virtual environments
.venv/
venv/
ENV/

# IDE / editor / OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# Local-only files (per-developer)
.claude/
# NOTE: .python-version is deliberately NOT ignored — it pins the interpreter to
# the same version the Docker image runs, so bare-metal and container don't
# drift. It's a project decision, not a per-developer preference.

# Env
.env
.env.*

# Node
node_modules/
frontend/dist/
frontend/.vite/
npm-debug.log*

# TypeScript incremental build cache — regenerated by every `tsc -b`, so
# tracking it just adds noise to every dependency-update PR.
*.tsbuildinfo

# Database / uploads
*.db
# WAL-mode sidecars — `*.db` doesn't match these, and they hold real data
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
uploads/

# Project-specific
Headroom.zip
analysis/

# Rolling backups written by a bare-metal run land in ./backups — whole DB,
# keys and tokens, one `git add -A` from a public repo.
backups/

# Private keys must never be committed.
*.pem
*.key

# Agent skills (per-developer tooling)
.agents/
skills-lock.json

# Local forensic-review bundle (code-archaeology output) — keep out of the repo
/analysis/

# Playwright MCP session logs (a review tool writes them into the cwd)
.playwright-mcp/

# Internal engineering notes and security-review records — deliberately LOCAL.
# This repository is public. A detailed account of how each past weakness
# worked, and of every guard and its edges, is a map for attacking a running
# instance — and any deployment that lags a release is described by it exactly.
# These files stay on disk for the maintainer and out of the published tree.
CLAUDE.md
docs/CODE-REVIEW-*.md
docs/AUDIT-HISTORY.md
