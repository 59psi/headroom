# Caddy config for the LAN-HTTPS overlay.
#
# This exists for ONE reason: to stop Caddy issuing twelve-hour certificates.
#
# Twelve hours is Caddy's default and it is a fine default — short-lived certs
# renew themselves and limit the blast radius of a stolen key. What it assumes
# is that renewal always works. On this deployment it stopped working (an
# unclean shutdown ate the stored private key), and Caddy then re-queued a
# renewal every ten minutes for THIRTY-SEVEN DAYS while serving an expired
# certificate. A cert that outlives the gap between someone noticing and
# someone fixing it is worth more here than a short blast radius on a LAN.
#
# 820 days is not an arbitrary number. Safari — and therefore every iPhone —
# rejects a TLS server certificate whose validity exceeds **825 days**, even
# when it chains to a manually installed root. (The widely-quoted 398-day cap
# applies only to certificates from Apple's PREINSTALLED roots; user-added
# roots get 825. Chrome and Firefox impose no limit at all here, which is
# exactly the trap: a longer cert would work on a laptop and fail on the
# phone.) 820 leaves headroom for clock skew.
#
# The ROOT is untouched and still lasts ten years (Caddy's 3600d default),
# because that is the certificate people actually install on their devices.
# Changing `intermediate_lifetime` regenerates the intermediate but NOT the
# root, so devices that already trust this CA keep trusting it — no reinstall.
{
	pki {
		ca local {
			# Caddy requires the issued lifetime to be under
			# renewal_window_ratio (default 1/3) x intermediate_lifetime, so an
			# 820-day leaf needs an intermediate of at least ~2460 days. 3000d
			# clears that and still sits below the 3600d root.
			intermediate_lifetime 3000d
		}
	}
}

# Every name and address this server answers on, comma-separated.
#
# Defaults to just `headroom.local`, which is enough on the LAN and nowhere
# else: `.local` is mDNS, and mDNS is link-local multicast that cannot cross a
# VPN, a tunnel, or a routed subnet. Reach the box through Teleport, Tailscale
# or WireGuard and the name simply does not resolve — there is nothing to fix
# in DNS, because no DNS is involved.
#
# The IP is not a fallback either, for two compounding reasons. Caddy rejects
# the TLS handshake outright when the SNI matches no site here, and even if it
# did not, the certificate carries `DNS:headroom.local` and no IP SAN, so the
# name check fails. Worse, Caddy's automatic HTTP->HTTPS redirect sends
# `http://<ip>/` to `https://<ip>/`, which is precisely the address that cannot
# work — a dead end that looks like the server is down.
#
# Adding the address here fixes all of it at once: it becomes a site Caddy
# serves, and Caddy puts it in the certificate as an IP SAN signed by the same
# root, so devices that already trust the CA trust it immediately.
#
#   HEADROOM_SITE_ADDRESSES="headroom.local, 10.0.111.4"
#
# Passkeys still only work on the name in HEADROOM_ORIGIN. WebAuthn credentials
# are bound to an origin, so one registered at https://headroom.local is not
# offered at https://10.0.111.4 — that is WebAuthn working correctly, not a
# misconfiguration. Password login works on both.
{$HEADROOM_SITE_ADDRESSES:headroom.local} {
	# `issuer internal { ... }`, not `tls internal { ... }` — the latter is
	# shorthand that accepts no options, and Caddy rejects `lifetime` inside it.
	tls {
		issuer internal {
			lifetime 820d
		}
	}

	# Caddy sets X-Forwarded-For/Proto/Host here automatically, which is what
	# lets the app mark session cookies `secure` behind this proxy. The app
	# trusts those headers from loopback only (FORWARDED_ALLOW_IPS), so a LAN
	# client hitting :8000 directly still cannot spoof its address.
	reverse_proxy localhost:8000
}
